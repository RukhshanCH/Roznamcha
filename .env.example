# ════════════════════════════════════════════════════════════
# Roznamcha — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ── Supabase (Frontend) ─────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Backend / Serverless Functions) ───────────────
# Service key bypasses RLS — only used server-side in api/ functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Safepay ─────────────────────────────────────────────────
# Sandbox: https://sandbox.api.getsafepay.com
# Production: https://api.getsafepay.com
# Use sandbox while testing; set to production only with production credentials.
SAFEPAY_ENV=sandbox
# API key used when creating payment sessions.
SAFEPAY_API_KEY=your-safepay-api-key
# Keep the secret key server-side for webhook signature verification.
SAFEPAY_SECRET_KEY=your-safepay-secret-key
# Webhook secret used to verify webhook signatures.
SAFEPAY_WEBHOOK_SECRET=your-safepay-webhook-secret

# ── App URL ─────────────────────────────────────────────────
# Used for Safepay redirect URLs after payment
APP_URL=http://localhost:5173
# On production set to: APP_URL=https://your-vercel-app.vercel.app
